{
  "name": "archflow",
  "private": true,
  "version": "0.4.0",
  "author": "2.end",
  "license": "MIT",
  "homepage": "https://archflow.2-end.online",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joao2end/Archflow.git"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Archflow — quadro branco de arquitetura de software com MCP. Desenvolvido pela 2.end.",
  "type": "module",
  "scripts": {
    "icons": "tsx scripts/build-icons.ts",
    "dev": "node scripts/free-bridge.mjs && vite --configLoader runner",
    "build": "npm run skill && tsc --noEmit && vite build --configLoader runner",
    "bridge": "tsx server/bridge.ts",
    "mcp": "tsx server/mcp.ts",
    "typecheck": "tsc --noEmit",
    "examples:build": "tsx scripts/build-examples.ts",
    "eval:domain": "tsx scripts/eval-domain.ts",
    "eval:jev": "tsx scripts/eval-jev.ts",
    "eval:scenario": "tsx scripts/eval-scenario.ts",
    "eval:nodes": "tsx scripts/eval-nodes.ts",
    "test": "tsx --test \"src/shared/*.test.ts\" \"server/*.test.ts\"",
    "electron:bundle": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --external:node-pty --outfile=dist-electron/main.cjs",
    "app": "npm run build && npm run electron:bundle && electron .",
    "app:icon": "tsx scripts/build-app-icon.ts",
    "app:dist": "npm run build && npm run electron:bundle && npm run mcp:bundle && electron-builder --win nsis -c.npmRebuild=false",
    "app:dist:mac": "npm run build && npm run electron:bundle && npm run mcp:bundle && electron-builder --mac --publish never",
    "app:dist:linux": "npm run build && npm run electron:bundle && npm run mcp:bundle && electron-builder --linux --publish never",
    "skill": "tsx scripts/build-skill.ts",
    "mcp:bundle": "tsx scripts/build-mcp.ts",
    "app:pack": "npm run build && npm run electron:bundle && npm run mcp:bundle && electron-builder --win dir -c.npmRebuild=false",
    "mcp:install": "npm run mcp:bundle && tsx server/mcp-install.ts",
    "mcp:check": "tsx server/mcp-install.ts --check",
    "mcp:smoke": "tsx scripts/smoke-mcp.ts"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.15",
    "@iconify-json/simple-icons": "^1.2.99",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "br.com.2end.archflow",
    "productName": "Archflow",
    "copyright": "2.end",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "!dist/landing/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Archflow",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1046"
    },
    "extraResources": [
      {
        "from": "dist-mcp/archflow-mcp.mjs",
        "to": "mcp/archflow-mcp.mjs"
      }
    ]
  }
}
