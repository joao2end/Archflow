{
  "name": "archflow",
  "private": true,
  "version": "0.1.0",
  "author": "2.end",
  "description": "Archflow — quadro branco de arquitetura de software com MCP. Desenvolvido pela 2.end.",
  "type": "module",
  "scripts": {
    "icons": "tsx scripts/build-icons.ts",
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "bridge": "tsx server/bridge.ts",
    "mcp": "tsx server/mcp.ts",
    "typecheck": "tsc --noEmit",
    "electron:bundle": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs",
    "app": "npm run build && npm run electron:bundle && electron .",
    "app:icon": "tsx scripts/build-app-icon.ts",
    "app:dist": "npm run build && npm run electron:bundle && electron-builder --win nsis"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.15",
    "@iconify-json/simple-icons": "^1.2.99",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "br.com.2end.archflow",
    "productName": "Archflow",
    "copyright": "2.end",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Archflow",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1046"
    }
  }
}
