    {
      "id": "g-vazia",
      "label": "A grade tem alguma linha?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "tamanho(grade) >= 1",
        "text": "Sem linhas não há grade.",
        "examples": [
          {
            "name": "tem",
            "given": {
              "grade": [
                "."
              ]
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "vazia",
            "given": {
              "grade": []
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 310,
      "y": 124,
      "w": 330,
      "h": 87
    },
    {
      "id": "mede",
      "label": "Medir a grade",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Linhas e colunas (o tamanho da primeira linha).",
        "then": [
          "H := tamanho(grade)",
          "L := tamanho(partir(grade[0], \"\"))"
        ],
        "examples": [
          {
            "name": "2×3",
            "given": {
              "grade": [
                "...",
                "..#"
              ]
            },
            "expect": {
              "H": 2,
              "L": 3
            }
          }
        ]
      },
      "x": 255,
      "y": 275,
      "w": 440,
      "h": 114
    },
    {
      "id": "g-retangular",
      "label": "Todas as linhas têm o mesmo tamanho?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "L >= 1 e vazio(filtrar(grade, tamanho(partir(item, \"\")) != L)) e vazio(filtrar(partir(juntar(grade, \"\"), \"\"), item != \".\" e item != \"#\"))",
        "text": "Linhas de tamanhos diferentes, ou com qualquer letra que não seja . ou #, não formam uma grade.",
        "examples": [
          {
            "name": "retangular",
            "given": {
              "grade": [
                "..",
                ".."
              ],
              "L": 2
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "torta",
            "given": {
              "grade": [
                "..",
                "..."
              ],
              "L": 2
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 310,
      "y": 453,
      "w": 330,
      "h": 130
    },
    {
      "id": "g-dentro",
      "label": "Início e fim estão dentro da grade?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "entre(inicio[0], 0, H - 1) e entre(inicio[1], 0, L - 1) e entre(fim[0], 0, H - 1) e entre(fim[1], 0, L - 1)",
        "text": "Linha entre 0 e H − 1 e coluna entre 0 e L − 1, nas duas casas.",
        "examples": [
          {
            "name": "dentro",
            "given": {
              "inicio": [
                0,
                0
              ],
              "fim": [
                1,
                1
              ],
              "H": 2,
              "L": 2
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "fora",
            "given": {
              "inicio": [
                0,
                0
              ],
              "fim": [
                2,
                0
              ],
              "H": 2,
              "L": 2
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 310,
      "y": 647,
      "w": 330,
      "h": 116
    },
    {
      "id": "g-livres",
      "label": "Início e fim estão em casas livres?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "partir(grade[inicio[0]], \"\")[inicio[1]] != \"#\" e partir(grade[fim[0]], \"\")[fim[1]] != \"#\"",
        "text": "Nenhuma das duas pode ser obstáculo.",
        "examples": [
          {
            "name": "livres",
            "given": {
              "grade": [
                "..",
                ".."
              ],
              "inicio": [
                0,
                0
              ],
              "fim": [
                1,
                1
              ]
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "obstáculo",
            "given": {
              "grade": [
                "#.",
                ".."
              ],
              "inicio": [
                0,
                0
              ],
              "fim": [
                1,
                1
              ]
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 310,
      "y": 827,
      "w": 330,
      "h": 102
    },
    {
      "id": "prepara",
      "label": "Começar só com a casa de início",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "A casa de início está aberta com 0 passos; nada visitado; sem caminho achado ainda.",
        "then": [
          "aberta := [[inicio[0] * L + inicio[1], abs(inicio[0] - fim[0]) + abs(inicio[1] - fim[1])]]",
          "gs := [[inicio[0] * L + inicio[1], 0]]",
          "fechados := []",
          "achou := falso",
          "custo := -1"
        ],
        "examples": [
          {
            "name": "começo",
            "given": {
              "inicio": [
                0,
                1
              ],
              "fim": [
                1,
                1
              ],
              "L": 3
            },
            "expect": {
              "aberta": [
                [
                  1,
                  1
                ]
              ],
              "gs": [
                [
                  1,
                  0
                ]
              ],
              "fechados": [],
              "achou": false,
              "custo": -1
            }
          }
        ]
      },
      "x": 255,
      "y": 993,
      "w": 440,
      "h": 231
    },
    {
      "id": "l-aberta",
      "label": "Acabou a busca?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "achou ou vazio(aberta)",
        "text": "Para quando o fim foi alcançado ou não resta casa aberta."
      },
      "x": 305,
      "y": 1288,
      "w": 340,
      "h": 101
    },
    {
      "id": "escolhe",
      "label": "Escolher a casa de menor estimativa",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Pega a menor estimativa total, a primeira casa que a tem, tira-a das abertas e separa linha e coluna.",
        "then": [
          "fmin := primeiro(ordenar(mapear(aberta, item[1])))",
          "atual := primeiro(filtrar(aberta, item[1] = fmin))[0]",
          "aberta := filtrar(aberta, item[0] != atual)",
          "r := piso(atual / L)",
          "c := atual % L",
          "gatual := primeiro(mapear(filtrar(gs, item[0] = atual), item[1]))"
        ],
        "examples": [
          {
            "name": "escolhe",
            "given": {
              "aberta": [
                [
                  4,
                  3
                ],
                [
                  1,
                  2
                ]
              ],
              "gs": [
                [
                  4,
                  2
                ],
                [
                  1,
                  1
                ]
              ],
              "L": 3
            },
            "expect": {
              "fmin": 2,
              "atual": 1,
              "aberta": [
                [
                  4,
                  3
                ]
              ],
              "r": 0,
              "c": 1,
              "gatual": 1
            }
          }
        ]
      },
      "x": 255,
      "y": 1453,
      "w": 440,
      "h": 253
    },
    {
      "id": "chegou",
      "label": "É a casa do fim?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "r = fim[0] e c = fim[1]",
        "text": "Como a estimativa nunca superestima, o primeiro caminho que chega ao fim é o menor.",
