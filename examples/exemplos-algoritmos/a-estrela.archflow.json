    {
      "id": "v-dentro",
      "label": "O vizinho está dentro da grade?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "entre(r2, 0, H - 1) e entre(c2, 0, L - 1)",
        "text": "Linha de 0 a H − 1 e coluna de 0 a L − 1.",
        "examples": [
          {
            "name": "dentro",
            "given": {
              "r2": 0,
              "c2": 1,
              "H": 2,
              "L": 2
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "fora",
            "given": {
              "r2": -1,
              "c2": 0,
              "H": 2,
              "L": 2
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 310,
      "y": 2456,
      "w": 330,
      "h": 116
    },
    {
      "id": "v-id",
      "label": "Numerar o vizinho",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "O número da casa é linha × largura + coluna.",
        "then": [
          "id2 := r2 * L + c2"
        ],
        "examples": [
          {
            "name": "id",
            "given": {
              "r2": 1,
              "c2": 2,
              "L": 3
            },
            "expect": {
              "id2": 5
            }
          }
        ]
      },
      "x": 310,
      "y": 2636,
      "w": 330,
      "h": 93
    },
    {
      "id": "v-livre",
      "label": "Está livre e ainda não foi visitado?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "partir(grade[r2], \"\")[c2] != \"#\" e contem(fechados, id2) = falso",
        "text": "Não pode ser obstáculo nem uma casa já visitada.",
        "examples": [
          {
            "name": "livre",
            "given": {
              "grade": [
                "..",
                ".."
              ],
              "r2": 0,
              "c2": 1,
              "fechados": [],
              "id2": 1
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "obstáculo",
            "given": {
              "grade": [
                "#.",
                ".."
              ],
              "r2": 0,
              "c2": 0,
              "fechados": [],
              "id2": 0
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 310,
      "y": 2793,
      "w": 330,
      "h": 116
    },
    {
      "id": "v-passos",
      "label": "Contar os passos pelo caminho de agora",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Um passo a mais que a casa escolhida; e o que já se conhecia do vizinho.",
        "then": [
          "tent := gatual + 1",
          "antigo := primeiro(mapear(filtrar(gs, item[0] = id2), item[1]))"
        ],
        "examples": [
          {
            "name": "novo",
            "given": {
              "gatual": 2,
              "gs": [],
              "id2": 7
            },
            "expect": {
              "tent": 3
            }
          }
        ]
      },
      "x": 255,
      "y": 2973,
      "w": 440,
      "h": 128
    },
    {
      "id": "v-nao-visto",
      "label": "O vizinho é novo (nunca alcançado)?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "vazio(antigo)",
        "text": "Sem passos conhecidos, é a primeira vez que se chega a ele.",
        "examples": [
          {
            "name": "novo",
            "given": {
              "antigo": null
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "já",
            "given": {
              "antigo": 4
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 310,
      "y": 3165,
      "w": 330,
      "h": 116
    },
    {
      "id": "v-melhor",
      "label": "O caminho de agora é mais curto?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "tent < antigo",
        "text": "Só vale se tiver menos passos que o já conhecido.",
        "examples": [
          {
            "name": "mais curto",
            "given": {
              "tent": 3,
              "antigo": 4
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "igual",
            "given": {
              "tent": 4,
              "antigo": 4
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 310,
      "y": 3345,
      "w": 330,
      "h": 116
    },
    {
      "id": "atualiza",
      "label": "Guardar o caminho e abrir o vizinho",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Guarda os passos até o vizinho e o põe nas abertas com a estimativa total: passos + distância em linha reta até o fim.",
        "then": [
          "gs := adicionar(filtrar(gs, item[0] != id2), [id2, tent])",
          "aberta := adicionar(filtrar(aberta, item[0] != id2), [id2, tent + abs(r2 - fim[0]) + abs(c2 - fim[1])])"
        ],
        "examples": [
          {
            "name": "abre",
            "given": {
              "gs": [],
              "aberta": [],
              "id2": 5,
              "tent": 2,
              "r2": 1,
              "c2": 2,
              "fim": [
                1,
                2
              ]
            },
            "expect": {
              "gs": [
                [
                  5,
                  2
                ]
              ],
              "aberta": [
                [
                  5,
                  2
                ]
              ]
            }
          }
        ]
      },
      "x": 255,
      "y": 3525,
      "w": 440,
      "h": 155
    },
    {
      "id": "pronto",
      "label": "Passos devolvidos",
      "kind": "logic",
      "logic": {
        "role": "end",
        "outcome": "ok",
        "text": "Devolve custo: o menor número de passos, ou -1 se não há caminho."
      },
      "x": 765,
      "y": 1549.5,
      "w": 280,
      "h": 60
    },
    {
      "id": "entrada-ruim",
      "label": "Entrada inválida",
      "kind": "logic",
      "logic": {
        "role": "end",
        "outcome": "erro",
        "text": "Grade vazia, torta ou com letra inválida, ou início ou fim fora da grade ou sobre um obstáculo: nada a calcular."
      },
      "x": 765,
      "y": 1078.5,
      "w": 280,
      "h": 60
    },
