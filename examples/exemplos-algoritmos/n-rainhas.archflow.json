    {
      "id": "volta",
      "label": "Voltar uma linha",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Tira a última rainha e passa a tentar a coluna seguinte à dela, na linha dela.",
        "then": [
          "topo := ultimo(rainhas)",
          "tentar := topo[1] + 1",
          "rainhas := filtrar(rainhas, item[0] != topo[0])"
        ],
        "examples": [
