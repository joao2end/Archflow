                  1,
                  3
                ]
              ]
            },
            "expect": {
              "topo": [
                1,
                3
              ],
              "tentar": 4,
              "rainhas": [
                [
                  0,
                  1
                ]
              ]
            }
          }
        ]
      },
      "x": 200,
      "y": 2066,
      "w": 440,
      "h": 149
    },
    {
      "id": "testa",
      "label": "Ver quem ataca a casa",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "A linha atual é o tamanho da pilha. Uma rainha ataca a casa se está na mesma coluna ou se a distância em colunas é igual à distância em linhas (diagonal).",
        "then": [
          "linha := tamanho(rainhas)",
          "ataques := filtrar(rainhas, item[1] = tentar ou abs(item[1] - tentar) = linha - item[0])"
        ],
        "examples": [
          {
            "name": "diagonal",
            "given": {
