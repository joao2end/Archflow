      "x": 990,
      "y": 44,
      "w": 250,
      "h": 46
    },
    {
      "id": "inicio",
      "label": "Achar o maior trecho sem repetição",
      "kind": "logic",
      "logic": {
        "role": "start",
        "text": "Entra a lista a."
      },
      "x": 255,
      "y": 0,
      "w": 280,
      "h": 60
    },
    {
      "id": "cada",
      "label": "Ainda há números a ler?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "i >= tamanho(a)",
        "text": "Uma volta por posição de a, da 0 até a última."
      },
      "x": 225,
      "y": 124,
      "w": 340,
      "h": 101
    },
    {
      "id": "ler",
      "label": "Ler o número e procurar a última vez",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Pega a[i] e procura em vistos o par desse número.",
        "then": [
          "atual := a[i]",
          "ult := primeiro(filtrar(vistos, item[0] = atual))"
        ],
        "examples": [
          {
            "name": "já visto",
            "given": {
              "a": [
                5,
                6,
                5
              ],
              "i": 2,
              "vistos": [
                [
                  5,
                  0
                ],
                [
                  6,
                  1
                ]
              ]
            },
            "expect": {
              "atual": 5,
              "ult": [
                5,
                0
              ]
            }
          },
          {
            "name": "novo",
            "given": {
              "a": [
                5,
                6
              ],
              "i": 1,
              "vistos": [
                [
                  5,
                  0
                ]
              ]
            },
            "expect": {
              "atual": 6
            }
          }
        ]
      },
      "x": 0,
      "y": 289,
      "w": 440,
      "h": 128
    },
    {
      "id": "novo",
      "label": "Esse número nunca apareceu?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "vazio(ult)",
        "text": "Se nunca apareceu, a janela não precisa encolher.",
        "examples": [
          {
            "name": "nunca",
            "given": {
              "ult": null
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "já",
            "given": {
              "ult": [
                5,
                0
              ]
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 230,
      "y": 481,
      "w": 330,
      "h": 101
    },
    {
      "id": "encolhe",
      "label": "Empurrar o começo da janela",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "A janela começa depois da última vez do número. Nunca recua: a última vez pode estar antes do começo atual.",
        "then": [
          "ini := max(ini, ult[1] + 1)"
        ],
        "examples": [
          {
            "name": "avança",
            "given": {
              "ini": 0,
              "ult": [
                5,
                2
              ]
            },
            "expect": {
              "ini": 3
            }
          },
          {
            "name": "não recua",
            "given": {
              "ini": 4,
              "ult": [
                5,
                1
              ]
            },
            "expect": {
              "ini": 4
            }
          }
        ]
      },
      "x": 175,
      "y": 646,
      "w": 440,
      "h": 93
    },
    {
      "id": "registra",
      "label": "Registrar a posição e medir a janela",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Troca o par antigo do número pelo novo [atual, i], mede i − ini + 1, guarda se for a maior e passa à próxima posição.",
        "then": [
          "vistos := adicionar(filtrar(vistos, item[0] != atual), [atual, i])",
          "melhor := max(melhor, i - ini + 1)",
          "i := i + 1"
        ],
        "examples": [
          {
            "name": "mede",
            "given": {
              "vistos": [],
              "atual": 4,
              "i": 0,
              "ini": 0,
              "melhor": 0
            },
            "expect": {
              "vistos": [
                [
                  4,
                  0
                ]
              ],
              "melhor": 1,
              "i": 1
            }
          }
        ]
      },
      "x": 175,
      "y": 803,
      "w": 440,
      "h": 162
    },
    {
      "id": "pronto",
      "label": "Tamanho devolvido",
      "kind": "logic",
      "logic": {
        "role": "end",
        "outcome": "ok",
        "text": "Devolve melhor."
      },
      "x": 510,
      "y": 323,
      "w": 280,
      "h": 60
    },
