    {
      "id": "inicio",
      "label": "Resolver a mochila",
      "kind": "logic",
      "logic": {
        "role": "start",
        "text": "Entram pesos, valores e cap."
      },
      "x": 735,
      "y": 0,
      "w": 280,
      "h": 60
    },
    {
      "id": "entrada-ok",
      "label": "A entrada é válida?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "tamanho(pesos) = tamanho(valores) e cap >= 0 e vazio(filtrar(pesos, item < 1))",
        "text": "Pesos e valores têm o mesmo tamanho, a capacidade não é negativa e nenhum peso é menor que 1.",
        "examples": [
          {
            "name": "válida",
            "given": {
              "pesos": [
                1,
                2
              ],
              "valores": [
                3,
                4
              ],
              "cap": 5
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "peso zero",
            "given": {
              "pesos": [
                0
              ],
              "valores": [
                3
              ],
              "cap": 5
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 710,
      "y": 124,
      "w": 330,
      "h": 115
    },
    {
      "id": "prepara",
      "label": "Preparar a tabela",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Conta os itens, zera os contadores e as listas.",
        "then": [
          "n := tamanho(pesos)",
          "anterior := []",
          "tabela := []",
          "escolhidos := []",
          "i := 0",
          "w := 0"
        ],
        "examples": [
          {
            "name": "3 itens",
            "given": {
              "pesos": [
                1,
                2,
                3
              ]
            },
            "expect": {
              "n": 3,
              "anterior": [],
              "tabela": [],
              "escolhidos": [],
              "i": 0,
              "w": 0
            }
          }
        ]
      },
      "x": 535,
      "y": 303,
      "w": 330,
      "h": 212
    },
    {
      "id": "l-zeros",
      "label": "A linha 0 já tem cap + 1 zeros?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "w > cap",
        "text": "Para quando w passou de cap. Sem itens, o valor é 0 em toda capacidade."
      },
      "x": 705,
      "y": 579,
      "w": 340,
      "h": 101
    },
    {
      "id": "zero-passo",
      "label": "Acrescentar um zero à linha 0",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Põe 0 no fim da linha e avança a coluna.",
        "then": [
          "anterior := adicionar(anterior, 0)",
          "w := w + 1"
        ],
        "examples": [
          {
            "name": "passo",
            "given": {
              "anterior": [],
              "w": 0
            },
            "expect": {
              "anterior": [
                0
              ],
              "w": 1
            }
          }
        ]
      },
      "x": 455,
      "y": 744,
      "w": 440,
      "h": 114
    },
    {
      "id": "guarda-base",
      "label": "Guardar a linha 0 na tabela",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "A tabela começa só com a linha de zeros.",
        "then": [
          "tabela := [anterior]"
        ],
        "examples": [
          {
            "name": "base",
            "given": {
              "anterior": [
                0,
                0
              ]
            },
            "expect": {
              "tabela": [
                [
                  0,
                  0
                ]
              ]
            }
          }
        ]
      },
      "x": 965,
      "y": 754.5,
      "w": 330,
      "h": 93
    },
    {
      "id": "l-itens",
      "label": "Todos os itens foram considerados?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "i >= n",
        "text": "Para quando i chegou a n. Cada volta monta a linha de um item."
      },
      "x": 705,
      "y": 922,
      "w": 340,
      "h": 116
    },
    {
      "id": "novo-item",
      "label": "Passar ao próximo item",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Avança i (o item da vez é o de posição i − 1), começa uma linha vazia e volta à coluna 0.",
        "then": [
          "i := i + 1",
          "atual := []",
          "w := 0"
        ],
        "examples": [
          {
            "name": "item 1",
            "given": {
              "i": 0
            },
            "expect": {
              "i": 1,
              "atual": [],
              "w": 0
            }
          }
        ]
      },
      "x": 510,
      "y": 1102,
      "w": 330,
      "h": 149
    },
    {
      "id": "l-colunas",
      "label": "A linha já tem cap + 1 células?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "w > cap",
        "text": "Para quando w passou de cap. Cada volta calcula uma célula."
      },
      "x": 500,
      "y": 1315,
      "w": 340,
      "h": 101
    },
    {
      "id": "deixa",
      "label": "Valor deixando o item",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "É o valor da linha de cima, na mesma coluna.",
        "then": [
          "sem := anterior[w]"
        ],
        "examples": [
          {
            "name": "deixa",
            "given": {
              "anterior": [
                0,
                3,
                3
              ],
              "w": 1
            },
            "expect": {
              "sem": 3
            }
          }
        ]
      },
      "x": 0,
      "y": 1484.5,
      "w": 330,
      "h": 107
    },
    {
      "id": "cabe",
      "label": "O peso do item cabe nesta capacidade?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "w >= pesos[i - 1]",
        "text": "O item da vez é o de posição i − 1. Peso igual à capacidade ainda cabe.",
        "examples": [
          {
            "name": "cabe",
            "given": {
              "w": 3,
              "pesos": [
                3
              ],
              "i": 1
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "não cabe",
            "given": {
              "w": 2,
              "pesos": [
                3
              ],
              "i": 1
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 80,
      "y": 1669.5,
      "w": 330,
      "h": 116
    },
    {
      "id": "leva",
      "label": "Valor levando o item",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Valor da linha de cima na coluna que sobra após o peso, mais o valor do item; vale o maior entre levar e deixar.",
        "then": [
          "com := anterior[w - pesos[i - 1]] + valores[i - 1]",
          "melhor := max(sem, com)"
        ],
        "examples": [
          {
            "name": "leva",
            "given": {
              "anterior": [
                0,
                0,
                0
              ],
              "w": 2,
              "pesos": [
                2
              ],
              "valores": [
                3
              ],
              "i": 1,
              "sem": 0
            },
            "expect": {
              "com": 3,
              "melhor": 3
            }
          }
        ]
      },
      "x": 400,
      "y": 1859,
      "w": 440,
      "h": 128
    },
    {
      "id": "so-deixa",
      "label": "Só dá para deixar o item",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "O peso não cabe: a célula é o valor da linha de cima.",
        "then": [
          "melhor := sem"
        ],
        "examples": [
          {
            "name": "deixa",
            "given": {
              "sem": 4
            },
            "expect": {
              "melhor": 4
            }
          }
        ]
      },
      "x": 910,
      "y": 1876.5,
      "w": 440,
      "h": 93
    },
    {
      "id": "guarda-celula",
      "label": "Guardar a célula",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Põe o valor no fim da linha e avança a coluna.",
        "then": [
          "atual := adicionar(atual, melhor)",
          "w := w + 1"
        ],
        "examples": [
          {
            "name": "guarda",
            "given": {
              "atual": [
                0
              ],
              "melhor": 3,
              "w": 1
            },
            "expect": {
              "atual": [
                0,
                3
              ],
              "w": 2
            }
          }
        ]
      },
      "x": 655,
      "y": 2051,
      "w": 440,
      "h": 114
    },
    {
      "id": "fecha-item",
      "label": "A linha pronta entra na tabela",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Guarda a linha na tabela e a torna a linha de cima do próximo item.",
        "then": [
          "tabela := adicionar(tabela, atual)",
          "anterior := atual"
        ],
        "examples": [
          {
            "name": "fecha",
            "given": {
              "tabela": [
                [
                  0,
                  0
                ]
              ],
              "atual": [
                0,
                3
              ]
            },
            "expect": {
              "tabela": [
                [
                  0,
                  0
                ],
                [
                  0,
                  3
                ]
              ],
              "anterior": [
                0,
                3
              ]
            }
          }
        ]
      },
      "x": 400,
      "y": 1481,
      "w": 440,
      "h": 114
    },
    {
      "id": "resposta",
      "label": "Ler a resposta e preparar a volta",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "O maior valor é a última célula da última linha. A volta começa nessa célula.",
        "then": [
          "valor := anterior[cap]",
          "w := cap",
          "i := n"
        ],
        "examples": [
          {
            "name": "lê",
            "given": {
              "anterior": [
                0,
                3,
                3
              ],
              "cap": 2,
              "n": 1
            },
            "expect": {
              "valor": 3,
              "w": 2,
              "i": 1
            }
          }
        ]
      },
      "x": 910,
      "y": 1102,
      "w": 330,
      "h": 149
    },
    {
      "id": "l-volta",
      "label": "Todos os itens foram examinados?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "i <= 0",
        "text": "Para quando i chegou a 0. Cada volta examina um item, do último para o primeiro."
      },
      "x": 910,
      "y": 1322,
      "w": 340,
      "h": 87
    },
    {
      "id": "ficou-fora",
      "label": "O valor é igual ao da linha de cima?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "tabela[i][w] = tabela[i - 1][w]",
        "text": "Se levar o item não melhora, ele ficou de fora. Em empate também.",
        "examples": [
          {
            "name": "fora",
            "given": {
              "tabela": [
                [
                  0,
                  0
                ],
                [
                  0,
                  0
                ]
              ],
              "i": 1,
              "w": 1
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "levado",
            "given": {
              "tabela": [
                [
                  0,
                  0
                ],
                [
                  0,
                  3
                ]
              ],
              "i": 1,
              "w": 1
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 910,
      "y": 1480,
      "w": 330,
      "h": 116
    },
    {
      "id": "pula",
      "label": "O item ficou de fora",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Só passa ao item de cima.",
        "then": [
          "i := i - 1"
        ],
        "examples": [
          {
            "name": "pula",
            "given": {
              "i": 2
            },
            "expect": {
              "i": 1
            }
          }
        ]
      },
      "x": 480,
      "y": 1681,
      "w": 330,
      "h": 93
    },
    {
      "id": "anota",
      "label": "O item foi levado",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Anota a posição do item (i − 1), tira o peso dele da capacidade e passa ao item de cima.",
        "then": [
          "escolhidos := adicionar(escolhidos, i - 1)",
          "w := w - pesos[i - 1]",
          "i := i - 1"
        ],
        "examples": [
          {
            "name": "anota",
            "given": {
              "escolhidos": [],
              "i": 2,
              "w": 7,
              "pesos": [
                1,
                3
              ]
            },
            "expect": {
              "escolhidos": [
                1
              ],
              "w": 4,
              "i": 1
            }
          }
        ]
      },
      "x": 880,
      "y": 1660,
      "w": 440,
      "h": 135
    },
    {
      "id": "ordena",
      "label": "Pôr os escolhidos em ordem crescente",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "A volta os achou do último para o primeiro.",
        "then": [
          "escolhidos := ordenar(escolhidos)"
        ],
        "examples": [
          {
            "name": "ordena",
            "given": {
              "escolhidos": [
                2,
                1
              ]
            },
            "expect": {
              "escolhidos": [
                1,
                2
              ]
            }
          }
        ]
      },
      "x": 1310,
      "y": 1491.5,
      "w": 440,
      "h": 93
    },
