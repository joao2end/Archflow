      "h": 186,
      "auto": true
    },
    {
      "id": "resultados",
      "label": "Resultados",
      "kind": "layer",
      "tag": "Output",
      "x": 1702,
      "y": -10,
      "w": 306,
      "h": 140,
      "auto": true
    },
    {
      "id": "variaveis",
      "label": "Variáveis do fluxo",
      "kind": "layer",
      "tag": "Variable",
      "x": 1702,
      "y": 108,
      "w": 306,
      "h": 244,
      "auto": true
    },
    {
      "id": "cenarios",
      "label": "Cenários que dão certo",
      "kind": "layer",
      "tag": "Caminhos de sucesso",
      "x": 1702,
