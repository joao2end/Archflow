      "logic": {
        "role": "rule",
        "text": "Dá ao vizinho o próximo número de descoberta (ind e low iguais), põe-no nas duas pilhas e zera o ponteiro das setas dele.",
        "then": [
          "ind := adicionar(filtrar(ind, item[0] != w), [w, contador])",
          "low := adicionar(filtrar(low, item[0] != w), [w, contador])",
          "prox := adicionar(filtrar(prox, item[0] != w), [w, 0])",
          "contador := contador + 1",
          "pilha := adicionar(pilha, w)",
          "chamadas := adicionar(chamadas, w)"
        ],
        "examples": [
