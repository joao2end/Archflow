      "label": "O low é igual ao número de descoberta?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "primeiro(mapear(filtrar(low, item[0] = v), item[1])) = primeiro(mapear(filtrar(ind, item[0] = v), item[1]))",
        "text": "Se o nó não alcança nada mais antigo que ele mesmo, é a raiz de um componente.",
        "examples": [
          {
            "name": "raiz",
            "given": {
              "low": [
                [
                  1,
                  2
                ]
              ],
              "ind": [
                [
                  1,
                  2
                ]
              ],
              "v": 1
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "não",
            "given": {
              "low": [
                [
                  1,
                  0
                ]
              ],
              "ind": [
                [
                  1,
                  2
                ]
              ],
              "v": 1
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 565,
      "y": 1823,
      "w": 330,
      "h": 116
    },
    {
      "id": "inicia-comp",
      "label": "Começar um componente",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "O componente em montagem está vazio.",
        "then": [
          "comp := []"
        ],
        "examples": [
          {
            "name": "vazio",
            "given": {},
            "expect": {
              "comp": []
            }
          }
        ]
      },
      "x": 565,
      "y": 2013.5,
      "w": 330,
      "h": 107
    },
    {
      "id": "l-pop",
      "label": "A raiz já saiu da pilha?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "contem(comp, v)",
        "text": "Para quando o nó de agora já está no componente."
      },
      "x": 560,
      "y": 2271.5,
      "w": 340,
      "h": 101
    },
    {
      "id": "pop",
      "label": "Tirar o último da pilha",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Passa o último nó da pilha de componente para o componente.",
        "then": [
          "topo := ultimo(pilha)",
          "pilha := filtrar(pilha, item != topo)",
          "comp := adicionar(comp, topo)"
        ],
        "examples": [
          {
            "name": "tira",
            "given": {
              "pilha": [
                1,
                2,
                3
              ],
              "comp": []
            },
            "expect": {
              "topo": 3,
              "pilha": [
                1,
                2
              ],
              "comp": [
                3
              ]
            }
          }
        ]
      },
      "x": 0,
      "y": 2519,
      "w": 440,
      "h": 135
    },
    {
      "id": "guarda-comp",
      "label": "Guardar o componente",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Acrescenta o componente, com os nós em ordem crescente, à resposta.",
        "then": [
          "componentes := adicionar(componentes, ordenar(comp))"
        ],
        "examples": [
          {
            "name": "guarda",
            "given": {
              "componentes": [],
              "comp": [
                3,
                1,
                2
              ]
            },
            "expect": {
              "componentes": [
                [
                  1,
                  2,
                  3
                ]
              ]
            }
          }
        ]
      },
      "x": 510,
      "y": 2540,
      "w": 440,
      "h": 93
    },
    {
      "id": "desempilha",
      "label": "Concluir o nó",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Tira o nó da pilha de chamadas.",
        "then": [
          "chamadas := filtrar(chamadas, item != v)"
        ],
        "examples": [
          {
            "name": "conclui",
            "given": {
              "chamadas": [
                1,
                2
              ],
              "v": 2
            },
            "expect": {
              "chamadas": [
                1
              ]
            }
          }
        ]
      },
      "x": 510,
      "y": 2718,
      "w": 440,
      "h": 93
    },
    {
      "id": "tem-pai",
      "label": "Resta algum nó chamador?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "tamanho(chamadas) > 0",
        "text": "Se resta, o nó concluído passa o seu low para quem o chamou.",
        "examples": [
          {
            "name": "resta",
            "given": {
              "chamadas": [
                1
              ]
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "vazia",
            "given": {
              "chamadas": []
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 565,
      "y": 2875,
      "w": 330,
      "h": 101
    },
    {
      "id": "sobe-low",
      "label": "Passar o low ao chamador",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "O low do chamador passa a ser o menor entre o dele e o do nó concluído.",
        "then": [
          "u := ultimo(chamadas)",
          "low := adicionar(filtrar(low, item[0] != u), [u, min(primeiro(mapear(filtrar(low, item[0] = u), item[1])), primeiro(mapear(filtrar(low, item[0] = v), item[1])))])"
        ],
        "examples": [
          {
            "name": "sobe",
            "given": {
              "chamadas": [
                1
              ],
              "low": [
                [
                  1,
                  1
                ],
                [
                  2,
                  0
                ]
              ],
              "v": 2
            },
            "expect": {
              "u": 1,
              "low": [
                [
                  2,
                  0
                ],
                [
                  1,
                  0
                ]
              ]
            }
          }
        ]
      },
      "x": 510,
      "y": 3040,
      "w": 440,
      "h": 141
    },
    {
      "id": "conta",
      "label": "Contar os componentes",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "A quantidade é o tamanho da lista de componentes.",
        "then": [
          "quantidade := tamanho(componentes)"
        ],
        "examples": [
          {
