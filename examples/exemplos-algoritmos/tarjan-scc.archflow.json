    {
      "id": "entrada-ok",
      "label": "Toda aresta liga nós da lista?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "vazio(filtrar(arestas, contem(nos, item[0]) = falso ou contem(nos, item[1]) = falso))",
        "text": "Nenhuma aresta pode citar um número que não está em nos.",
        "examples": [
          {
            "name": "ok",
            "given": {
              "nos": [
                1,
                2
              ],
              "arestas": [
                [
                  1,
                  2
                ]
              ]
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "fora",
            "given": {
              "nos": [
                1,
                2
              ],
              "arestas": [
                [
                  1,
                  3
                ]
              ]
            },
            "expect": {
              "caminho": "nao"
