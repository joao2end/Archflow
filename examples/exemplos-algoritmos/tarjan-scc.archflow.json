    {
      "id": "low-w",
      "label": "Baixar o low pelo vizinho",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "O low do nó passa a ser o menor entre o dele e o número de descoberta do vizinho.",
        "then": [
          "low := adicionar(filtrar(low, item[0] != v), [v, min(primeiro(mapear(filtrar(low, item[0] = v), item[1])), primeiro(mapear(filtrar(ind, item[0] = w), item[1])))])"
        ],
        "examples": [
