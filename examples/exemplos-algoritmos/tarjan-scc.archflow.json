    {
      "id": "visita-raiz",
      "label": "Iniciar a busca neste nó",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Dá ao nó o próximo número de descoberta (ind e low iguais), põe o nó nas duas pilhas e zera o ponteiro das setas dele.",
        "then": [
          "ind := adicionar(filtrar(ind, item[0] != s), [s, contador])",
          "low := adicionar(filtrar(low, item[0] != s), [s, contador])",
          "prox := adicionar(filtrar(prox, item[0] != s), [s, 0])",
          "contador := contador + 1",
          "pilha := adicionar(pilha, s)",
          "chamadas := adicionar(chamadas, s)"
        ],
        "examples": [
          {
            "name": "primeiro nó",
            "given": {
              "s": 7,
              "contador": 0,
              "ind": [],
              "low": [],
              "prox": [],
              "pilha": [],
              "chamadas": []
            },
            "expect": {
              "ind": [
                [
                  7,
                  0
                ]
              ],
              "low": [
                [
                  7,
                  0
                ]
              ],
              "prox": [
                [
                  7,
                  0
                ]
              ],
              "contador": 1,
              "pilha": [
                7
              ],
              "chamadas": [
                7
              ]
            }
          }
        ]
      },
      "x": 510,
      "y": 944,
      "w": 440,
      "h": 266
    },
    {
      "id": "visita-filho",
      "label": "Descer até o vizinho",
