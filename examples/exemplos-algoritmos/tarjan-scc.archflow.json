    {
      "id": "caso-classico",
      "label": "Três componentes",
      "kind": "logic",
      "parent": "cenarios",
      "logic": {
        "role": "scenario",
        "text": "Oito nós: {1,2,3} formam um ciclo, {4,5,6} outro, {7,8} outro; as setas entre eles vão num só sentido. Os componentes saem na ordem 4-5-6, 1-2-3, 7-8.",
        "examples": [
