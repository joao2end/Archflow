      "h": 266
    },
    {
      "id": "l-dfs",
      "label": "A busca terminou?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "vazio(chamadas)",
        "text": "Para quando não resta nó na pilha de chamadas. Cada volta examina uma seta do último nó ou o conclui."
