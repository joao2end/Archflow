    {
      "id": "frame",
      "label": "Olhar o nó de agora",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Pega o último da pilha de chamadas, os vizinhos dele e quantas setas já foram examinadas.",
        "then": [
          "v := ultimo(chamadas)",
          "viz := mapear(filtrar(arestas, item[0] = v), item[1])",
          "k := primeiro(mapear(filtrar(prox, item[0] = v), item[1]))"
        ],
        "examples": [
          {
            "name": "frame",
            "given": {
              "chamadas": [
