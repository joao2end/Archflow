    {
      "id": "inicio",
      "label": "Calcular a distância de edição",
      "kind": "logic",
      "logic": {
        "role": "start",
        "text": "Entram `de` e `para`."
      },
      "x": 335,
      "y": 0,
      "w": 280,
      "h": 60
    },
    {
      "id": "prepara",
      "label": "Separar as letras e começar a linha 0",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Transforma os textos em listas de letras (texto vazio vira lista vazia), guarda os tamanhos, zera os contadores i e j e começa a linha 0 só com o 0 (transformar vazio em vazio custa 0).",
        "then": [
          "letras_de := partir(de, \"\")",
          "letras_para := partir(para, \"\")",
          "n := tamanho(letras_de)",
          "m := tamanho(letras_para)",
          "anterior := [0]",
          "i := 0",
          "j := 0"
        ],
        "examples": [
          {
            "name": "duas palavras",
            "given": {
              "de": "ab",
              "para": "c"
            },
            "expect": {
              "letras_de": [
                "a",
                "b"
              ],
              "letras_para": [
                "c"
              ],
              "n": 2,
              "m": 1,
              "anterior": [
                0
              ],
              "i": 0,
              "j": 0
            }
          }
        ]
      },
      "x": 255,
      "y": 124,
      "w": 440,
      "h": 219
    },
    {
      "id": "l-base",
      "label": "A linha 0 já tem m+1 itens?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "j >= m",
        "text": "Para quando j chegou a m. A linha 0 é 0, 1, 2, …, m: criar j letras custa j inserções."
      },
      "x": 305,
      "y": 407,
      "w": 340,
      "h": 101
    },
    {
      "id": "base-passo",
      "label": "Acrescentar j à linha 0",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Avança j e põe j no fim da linha.",
        "then": [
          "j := j + 1",
          "anterior := adicionar(anterior, j)"
        ],
        "examples": [
          {
            "name": "passo",
            "given": {
              "j": 0,
              "anterior": [
                0
              ]
            },
            "expect": {
              "j": 1,
              "anterior": [
                0,
                1
              ]
            }
          }
        ]
      },
      "x": -205,
      "y": 573,
      "w": 440,
      "h": 114
    },
    {
      "id": "l-linhas",
      "label": "Todas as letras de `de` foram usadas?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "i >= n",
        "text": "Para quando i chegou a n. Cada volta monta uma linha da tabela."
      },
      "x": 305,
      "y": 572,
      "w": 340,
      "h": 116
    },
    {
      "id": "nova-linha",
      "label": "Começar a próxima linha",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Avança i; a linha começa com i (apagar as i letras de `de`) e as colunas voltam a 0.",
        "then": [
          "i := i + 1",
          "atual := [i]",
          "j := 0"
        ],
        "examples": [
          {
            "name": "linha 2",
            "given": {
              "i": 1
            },
            "expect": {
              "i": 2,
              "atual": [
                2
              ],
              "j": 0
            }
          }
        ]
      },
      "x": 310,
      "y": 752,
      "w": 330,
      "h": 135
    },
    {
      "id": "l-colunas",
      "label": "A linha já tem m+1 itens?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "j >= m",
        "text": "Para quando j chegou a m. Cada volta calcula uma célula da linha."
      },
      "x": 305,
      "y": 951,
      "w": 340,
      "h": 101
    },
    {
      "id": "le-celula",
      "label": "Ir para a próxima coluna",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Avança j. A célula é a de i letras de `de` e j letras de `para`.",
        "then": [
          "j := j + 1"
        ],
        "examples": [
          {
            "name": "coluna 1",
            "given": {
              "j": 0
            },
            "expect": {
              "j": 1
            }
          }
        ]
      },
      "x": 310,
      "y": 1116,
      "w": 330,
      "h": 93
    },
    {
      "id": "mesma-letra",
      "label": "As duas letras são iguais?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "letras_de[i - 1] = letras_para[j - 1]",
        "text": "Compara a i-ésima letra de `de` com a j-ésima de `para` (a primeira é a de número 1).",
        "examples": [
          {
            "name": "iguais",
            "given": {
              "letras_de": [
                "a",
                "b"
              ],
              "letras_para": [
                "x",
                "b"
              ],
              "i": 2,
              "j": 2
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "diferentes",
            "given": {
              "letras_de": [
                "a",
                "b"
              ],
              "letras_para": [
                "x",
                "c"
              ],
              "i": 2,
              "j": 2
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 310,
      "y": 1273,
      "w": 330,
      "h": 115
    },
    {
      "id": "diag-igual",
      "label": "Diagonal sem custo",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Letras iguais: a distância é a mesma da diagonal.",
        "then": [
          "sub := anterior[j - 1]"
        ],
        "examples": [
          {
            "name": "sem custo",
            "given": {
              "anterior": [
                3,
                2,
                1
              ],
              "j": 2
            },
            "expect": {
              "sub": 2
            }
          }
        ]
      },
      "x": 255,
      "y": 1452,
      "w": 440,
      "h": 93
    },
    {
      "id": "diag-troca",
      "label": "Diagonal com troca",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Letras diferentes: trocar uma pela outra custa 1 a mais que a diagonal.",
        "then": [
          "sub := anterior[j - 1] + 1"
        ],
        "examples": [
          {
            "name": "troca",
            "given": {
              "anterior": [
                3,
                2,
                1
              ],
              "j": 2
            },
            "expect": {
              "sub": 3
            }
          }
        ]
      },
      "x": 765,
      "y": 1452,
      "w": 440,
      "h": 93
    },
    {
      "id": "celula",
      "label": "Escolher o menor e guardar a célula",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Menor entre apagar (a célula de cima + 1), inserir (a célula da esquerda + 1) e a diagonal; coloca no fim da linha.",
        "then": [
          "melhor := min(anterior[j] + 1, atual[j - 1] + 1, sub)",
          "atual := adicionar(atual, melhor)"
        ],
        "examples": [
          {
            "name": "célula",
            "given": {
              "anterior": [
                1,
                1,
                2
              ],
              "atual": [
                2
              ],
              "j": 1,
              "sub": 2
            },
            "expect": {
              "melhor": 2,
              "atual": [
                2,
                2
              ]
            }
          }
        ]
      },
      "x": 255,
      "y": 1609,
      "w": 440,
      "h": 128
    },
    {
      "id": "fecha-linha",
      "label": "A linha pronta vira a anterior",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Guarda a linha montada para a próxima volta.",
        "then": [
          "anterior := atual"
        ],
        "examples": [
          {
            "name": "troca de linha",
            "given": {
              "atual": [
                1,
                1,
                2
              ]
            },
            "expect": {
              "anterior": [
                1,
                1,
                2
              ]
            }
          }
        ]
      },
      "x": 710,
      "y": 1116,
      "w": 440,
      "h": 93
    },
    {
      "id": "responde",
      "label": "A resposta é a última célula",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "A distância entre as palavras inteiras é o último item da última linha.",
        "then": [
          "resultado := anterior[m]"
        ],
        "examples": [
          {
