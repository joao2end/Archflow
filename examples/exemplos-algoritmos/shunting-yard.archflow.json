        "then": [
          "topo := primeiro(mapear(filtrar(ops, item[0] = tamanho(ops) - 1), item[1]))",
          "precTopo := 2 * tamanho(filtrar([\"*\", \"/\"], item = topo)) + tamanho(filtrar([\"+\", \"-\"], item = topo))"
