    {
      "id": "inicio",
      "label": "Executar as operações",
      "kind": "logic",
      "logic": {
        "role": "start",
        "text": "Entram n e ops."
      },
      "x": 535,
      "y": 0,
      "w": 280,
      "h": 60
    },
    {
      "id": "prepara",
      "label": "Cada elemento sozinho",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Todo elemento começa como a própria raiz: n grupos, nenhuma resposta ainda.",
        "then": [
          "pais := []",
          "i := 0",
          "saidas := []",
          "grupos := n"
        ],
        "examples": [
          {
            "name": "zera",
            "given": {
              "n": 3
            },
            "expect": {
              "pais": [],
              "i": 0,
              "saidas": [],
              "grupos": 3
            }
          }
        ]
      },
      "x": 455,
      "y": 124,
      "w": 440,
      "h": 156
    },
    {
      "id": "l-init",
      "label": "Já há um pai para cada elemento?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "i >= n",
        "text": "Para quando i chegou a n."
      },
      "x": 505,
      "y": 344,
      "w": 340,
      "h": 101
    },
    {
      "id": "init-passo",
      "label": "O elemento i é pai de si mesmo",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Acrescenta o par [i, i] e avança i.",
        "then": [
          "pais := adicionar(pais, [i, i])",
          "i := i + 1"
        ],
        "examples": [
          {
            "name": "passo",
            "given": {
              "pais": [],
              "i": 0
            },
            "expect": {
              "pais": [
                [
                  0,
                  0
                ]
              ],
              "i": 1
            }
          }
        ]
      },
      "x": -5,
      "y": 509,
      "w": 440,
      "h": 114
    },
    {
      "id": "l-ops",
      "label": "Para cada operação de ops",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "foreach": "ops",
        "as": "op",
        "text": "Uma volta por operação, na ordem. op[0] é o tipo e op[1], op[2] são os dois elementos."
      },
      "x": 505,
      "y": 522.5,
      "w": 340,
      "h": 87
    },
    {
      "id": "pega-op",
      "label": "Ler a operação",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Separa o tipo e o par de elementos; ainda não há raízes.",
        "then": [
          "tipo := op[0]",
          "pares := [op[1], op[2]]",
          "raizes := []"
        ],
        "examples": [
          {
            "name": "union",
            "given": {
              "op": [
                "union",
                0,
                1
              ]
            },
            "expect": {
              "tipo": "union",
              "pares": [
                0,
                1
              ],
              "raizes": []
            }
          }
        ]
      },
      "x": 455,
      "y": 687,
      "w": 440,
      "h": 135
    },
    {
      "id": "tipo-ok",
      "label": "A operação é válida?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "(tipo = \"union\" ou tipo = \"conectados\") e entre(op[1], 0, n - 1) e entre(op[2], 0, n - 1)",
        "text": "Só existem union e conectados, e os dois elementos têm de estar entre 0 e n − 1.",
        "examples": [
          {
            "name": "válida",
            "given": {
              "tipo": "union",
              "op": [
                "union",
                0,
                1
              ],
              "n": 2
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "tipo desconhecido",
            "given": {
              "tipo": "del",
              "op": [
                "del",
                0,
                1
              ],
              "n": 2
            },
            "expect": {
              "caminho": "nao"
            }
          },
          {
            "name": "elemento fora",
            "given": {
              "tipo": "union",
              "op": [
                "union",
                0,
                5
              ],
              "n": 2
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 510,
      "y": 886,
      "w": 330,
      "h": 101
    },
    {
      "id": "l-pares",
      "label": "Para cada elemento do par",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "foreach": "pares",
        "as": "v",
        "text": "Uma volta para cada um dos dois elementos: acha a raiz do grupo dele e religa o caminho direto à raiz."
      },
      "x": 505,
      "y": 1051,
      "w": 340,
      "h": 87
    },
    {
      "id": "inicia-busca",
      "label": "Começar a subir de v",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "A subida parte do próprio elemento.",
        "then": [
          "atual := v"
        ],
        "examples": [
          {
            "name": "sobe de 3",
            "given": {
              "v": 3
            },
            "expect": {
              "atual": 3
            }
          }
        ]
      },
      "x": 510,
      "y": 1202,
      "w": 330,
      "h": 93
    },
    {
      "id": "l-sobe",
      "label": "O elemento é a própria raiz?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "primeiro(mapear(filtrar(pais, item[0] = atual), item[1])) = atual",
        "text": "Para quando o pai do elemento é ele mesmo."
      },
      "x": 505,
      "y": 1359,
      "w": 340,
      "h": 115
    },
    {
      "id": "sobe",
      "label": "Subir para o pai",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "O elemento passa a ser o pai dele.",
        "then": [
          "atual := primeiro(mapear(filtrar(pais, item[0] = atual), item[1]))"
        ],
        "examples": [
          {
            "name": "sobe",
            "given": {
              "atual": 3,
              "pais": [
                [
                  3,
                  2
                ],
                [
                  2,
                  2
                ]
              ]
            },
            "expect": {
              "atual": 2
            }
          }
        ]
      },
      "x": 0,
      "y": 1555,
      "w": 440,
      "h": 107
    },
    {
      "id": "achou-raiz",
      "label": "Guardar a raiz e voltar ao começo",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Guarda a raiz achada e volta ao elemento de partida para religar o caminho.",
        "then": [
          "raiz := atual",
          "percorrido := v"
        ],
        "examples": [
          {
            "name": "raiz",
            "given": {
              "atual": 2,
              "v": 3
            },
            "expect": {
              "raiz": 2,
              "percorrido": 3
            }
          }
        ]
      },
      "x": 510,
      "y": 1551.5,
      "w": 330,
      "h": 114
    },
    {
      "id": "l-comprime",
      "label": "O caminho chegou à raiz?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "percorrido = raiz",
        "text": "Para quando o elemento do caminho é a raiz."
      },
      "x": 505,
      "y": 1743,
      "w": 340,
      "h": 101
    },
    {
      "id": "comprime",
      "label": "Ligar o elemento direto à raiz",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Guarda o pai antigo, troca o pai do elemento pela raiz e segue para o pai antigo.",
        "then": [
          "prox := primeiro(mapear(filtrar(pais, item[0] = percorrido), item[1]))",
          "pais := adicionar(filtrar(pais, item[0] != percorrido), [percorrido, raiz])",
          "percorrido := prox"
        ],
        "examples": [
          {
            "name": "liga",
            "given": {
              "pais": [
                [
                  3,
                  2
                ],
                [
                  2,
                  1
                ],
                [
                  1,
                  1
                ]
              ],
              "percorrido": 3,
              "raiz": 1
            },
            "expect": {
              "prox": 2,
              "pais": [
                [
                  2,
                  1
                ],
                [
                  1,
                  1
                ],
                [
                  3,
                  1
                ]
              ],
              "percorrido": 2
            }
          }
        ]
      },
      "x": 455,
      "y": 1908,
      "w": 440,
      "h": 176
    },
    {
      "id": "guarda-raiz",
      "label": "Guardar a raiz do elemento",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Acrescenta a raiz achada às raízes do par.",
        "then": [
          "raizes := adicionar(raizes, raiz)"
        ],
        "examples": [
          {
            "name": "guarda",
            "given": {
              "raizes": [],
              "raiz": 4
            },
            "expect": {
              "raizes": [
                4
              ]
            }
          }
        ]
      },
      "x": 965,
      "y": 1949.5,
      "w": 440,
      "h": 93
    },
    {
      "id": "eh-union",
      "label": "É uma união?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "tipo = \"union\"",
        "text": "Senão é uma pergunta «conectados».",
        "examples": [
          {
            "name": "união",
            "given": {
              "tipo": "union"
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "pergunta",
            "given": {
              "tipo": "conectados"
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 910,
      "y": 1205,
      "w": 330,
      "h": 87
    },
    {
      "id": "diferentes",
      "label": "Os dois estão em grupos diferentes?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "raizes[0] != raizes[1]",
        "text": "Só se juntam grupos diferentes.",
        "examples": [
          {
            "name": "diferentes",
            "given": {
              "raizes": [
                1,
                2
              ]
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "iguais",
            "given": {
              "raizes": [
                1,
                1
              ]
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 915,
      "y": 1365.5,
      "w": 330,
      "h": 102
    },
    {
      "id": "junta",
      "label": "Juntar os dois grupos",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Liga a raiz do primeiro grupo à raiz do segundo: sobra um grupo a menos.",
        "then": [
          "pais := adicionar(filtrar(pais, item[0] != raizes[0]), [raizes[0], raizes[1]])",
          "grupos := grupos - 1"
        ],
        "examples": [
          {
            "name": "junta",
            "given": {
              "pais": [
                [
                  0,
                  0
                ],
                [
                  1,
                  1
                ]
              ],
              "raizes": [
                0,
                1
              ],
              "grupos": 2
            },
            "expect": {
              "pais": [
                [
                  1,
                  1
                ],
                [
                  0,
                  1
                ]
              ],
              "grupos": 1
            }
          }
        ]
      },
      "x": 910,
      "y": 1538,
      "w": 440,
      "h": 141
    },
    {
      "id": "pergunta",
      "label": "Responder se estão no mesmo grupo",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Estão no mesmo grupo quando têm a mesma raiz.",
        "then": [
          "saidas := adicionar(saidas, raizes[0] = raizes[1])"
        ],
        "examples": [
          {
            "name": "sim",
            "given": {
              "saidas": [],
              "raizes": [
