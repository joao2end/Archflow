      },
      "x": 965,
      "y": 724.5,
      "w": 280,
      "h": 60
    },
    {
      "id": "op-invalida",
      "label": "Operação inválida",
      "kind": "logic",
      "logic": {
        "role": "end",
        "outcome": "erro",
