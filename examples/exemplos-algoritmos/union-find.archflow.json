                3
              ]
            },
            "expect": {
              "saidas": [
                true
              ]
            }
          },
          {
            "name": "não",
            "given": {
              "saidas": [],
              "raizes": [
                3,
                4
              ]
            },
            "expect": {
              "saidas": [
                false
              ]
            }
          }
        ]
      },
      "x": 1315,
      "y": 1363,
      "w": 440,
      "h": 107
    },
    {
      "id": "pronto",
      "label": "Respostas devolvidas",
      "kind": "logic",
      "logic": {
