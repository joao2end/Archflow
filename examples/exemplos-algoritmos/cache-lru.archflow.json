      "x": 1900,
      "y": 468,
      "w": 320,
      "h": 73
    },
    {
      "id": "caso-invalida",
      "label": "Operação desconhecida",
      "kind": "logic",
      "parent": "cenarios-falha",
      "logic": {
        "role": "scenario",
        "text": "Uma operação «del» não é get nem put: o fluxo termina com erro.",
        "examples": [
          {
            "name": "del",
            "given": {
              "cap": 2,
              "ops": [
                [
                  "del",
                  1
                ]
              ]
            },
            "expect": {
              "desfecho": "erro"
            }
          }
        ]
      },
      "x": 1900,
      "y": 702,
      "w": 320,
      "h": 73
    },
    {
      "id": "caso-vazio",
      "label": "Sem operações",
      "kind": "logic",
      "parent": "cenarios",
      "logic": {
        "role": "scenario",
        "text": "ops vazio devolve lista vazia.",
        "examples": [
          {
