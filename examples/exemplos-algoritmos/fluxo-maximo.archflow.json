    {
      "id": "passo-gargalo",
      "label": "Ver a capacidade da seta",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Pega o nó anterior, a capacidade restante da seta e fica com a menor até agora.",
        "then": [
          "p := primeiro(mapear(filtrar(pai, item[0] = x), item[1]))",
          "c := soma(mapear(filtrar(res, item[0] = p e item[1] = x), item[2]))",
          "gargalo := min(gargalo, c)",
          "x := p"
        ],
        "examples": [
          {
            "name": "passo",
            "given": {
              "pai": [
                [
                  2,
                  1
                ]
              ],
              "x": 2,
              "res": [
                [
                  1,
                  2,
                  5
                ]
              ],
              "gargalo": 99
            },
            "expect": {
              "p": 1,
              "c": 5,
              "gargalo": 5,
              "x": 1
            }
          }
        ]
      },
      "x": 510,
      "y": 1623,
      "w": 440,
      "h": 184
    },
