    {
      "id": "passo-atualiza",
      "label": "Enviar o gargalo por esta seta",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Diminui a capacidade restante da seta e aumenta a da seta contrária (o que permite desfazer o fluxo depois).",
        "then": [
          "p := primeiro(mapear(filtrar(pai, item[0] = x), item[1]))",
          "res := adicionar(filtrar(res, item[0] != p ou item[1] != x), [p, x, soma(mapear(filtrar(res, item[0] = p e item[1] = x), item[2])) - gargalo])",
          "res := adicionar(filtrar(res, item[0] != x ou item[1] != p), [x, p, soma(mapear(filtrar(res, item[0] = x e item[1] = p), item[2])) + gargalo])",
          "x := p"
        ],
        "examples": [
          {
            "name": "envia",
            "given": {
              "pai": [
                [
