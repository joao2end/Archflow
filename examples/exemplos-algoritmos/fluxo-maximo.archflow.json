    {
      "id": "entrada-ok",
      "label": "A entrada é válida?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "fonte != sumidouro e contem(nos, fonte) e contem(nos, sumidouro) e vazio(filtrar(arestas, contem(nos, item[0]) = falso ou contem(nos, item[1]) = falso ou item[2] < 0 ou item[2] >= inf))",
        "text": "Fonte e sumidouro diferentes e em nos, arestas só entre nós de nos e toda capacidade entre 0 e menos de inf (1000000).",
        "examples": [
          {
            "name": "ok",
            "given": {
              "nos": [
                1,
                2
              ],
              "arestas": [
                [
                  1,
                  2,
                  1
                ]
              ],
              "fonte": 1,
              "sumidouro": 2
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "mesma",
            "given": {
              "nos": [
                1,
                2
              ],
              "arestas": [
                [
                  1,
                  2,
                  1
                ]
              ],
              "fonte": 1,
              "sumidouro": 1
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 510,
      "y": 124,
      "w": 330,
      "h": 115
    },
    {
      "id": "prepara",
      "label": "Começar com todo o fluxo por passar",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "A capacidade restante é a original e o fluxo é zero.",
        "then": [
          "res := arestas",
          "fluxo := 0",
          "terminou := falso"
        ],
        "examples": [
          {
            "name": "copia",
            "given": {
