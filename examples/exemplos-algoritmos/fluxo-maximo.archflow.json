    },
    {
      "id": "pega",
      "label": "Pegar o próximo da fila",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Examina o nó da posição h e separa as setas dele que ainda têm capacidade.",
        "then": [
          "u := fila[h]",
          "h := h + 1",
          "cand := filtrar(res, item[0] = u e item[2] > 0)"
        ],
        "examples": [
          {
            "name": "pega",
            "given": {
              "fila": [
                1
              ],
              "h": 0,
              "res": [
                [
                  1,
                  2,
                  5
                ],
                [
                  1,
                  3,
                  0
                ]
              ]
            },
            "expect": {
              "u": 1,
              "h": 1,
              "cand": [
                [
                  1,
                  2,
                  5
                ]
              ]
            }
          }
        ]
      },
      "x": 255,
      "y": 1052,
      "w": 440,
      "h": 149
    },
    {
