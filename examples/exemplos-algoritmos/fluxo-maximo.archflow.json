    },
    {
      "id": "marca",
      "label": "Alcançar o nó",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Marca o nó, guarda de onde veio e põe no fim da fila.",
        "then": [
          "visitados := adicionar(visitados, seta[1])",
          "pai := adicionar(pai, [seta[1], u])",
          "fila := adicionar(fila, seta[1])"
        ],
        "examples": [
          {
            "name": "marca",
            "given": {
              "visitados": [
                1
              ],
              "pai": [],
              "fila": [
                1
              ],
              "seta": [
                1,
                2,
                5
              ],
              "u": 1
            },
            "expect": {
              "visitados": [
                1,
                2
              ],
              "pai": [
                [
                  2,
                  1
                ]
              ],
              "fila": [
                1,
                2
              ]
            }
          }
        ]
      },
      "x": 0,
