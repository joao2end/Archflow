    {
      "id": "l-busca",
      "label": "A busca acabou?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "h >= tamanho(fila) ou contem(visitados, sumidouro)",
        "text": "Para quando a fila esgotou ou o sumidouro foi alcançado."
      },
      "x": 505,
      "y": 873,
      "w": 340,
