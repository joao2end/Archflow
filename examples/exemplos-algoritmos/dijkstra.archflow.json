    {
      "id": "inicio",
      "label": "Achar o menor caminho",
      "kind": "logic",
      "logic": {
        "role": "start",
        "text": "Entram nos, arestas, origem e destino."
      },
      "x": 335,
      "y": 0,
      "w": 280,
      "h": 60
    },
    {
      "id": "prepara",
      "label": "Iniciar as distâncias",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Nenhum nó foi alcançado, exceto a origem, que está a 0.",
        "then": [
          "dist := mapear(nos, [item, inf])",
          "dist := adicionar(filtrar(dist, item[0] != origem), [origem, 0])"
        ],
        "examples": [
          {
            "name": "2 nós",
            "given": {
              "nos": [
                1,
                2
              ],
              "origem": 1,
              "inf": 99
            },
            "expect": {
              "dist": [
                [
                  2,
                  99
                ],
                [
                  1,
                  0
                ]
              ]
            }
          }
        ]
      },
      "x": 255,
      "y": 124,
      "w": 440,
      "h": 141
    },
    {
      "id": "externo",
      "label": "Sobrou algum nó por fechar?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "vazio(filtrar(dist, contem(feitos, item[0]) = falso e item[1] < inf))",
        "text": "Para quando todo nó alcançado já foi fechado (não resta candidato: nó não fechado com distância menor que infinito). Uma volta fecha um nó."
      },
      "x": 305,
      "y": 329,
      "w": 340,
      "h": 115
    },
    {
      "id": "fecha",
      "label": "Fechar o candidato mais perto",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Candidato é nó ainda não fechado e já alcançado. Pega a menor distância entre os candidatos, fecha um nó com essa distância e separa as arestas que saem dele.",
        "then": [
          "candidatos := filtrar(dist, contem(feitos, item[0]) = falso e item[1] < inf)",
          "dmin := primeiro(ordenar(mapear(candidatos, item[1])))",
          "u := primeiro(filtrar(candidatos, item[1] = dmin))[0]",
          "feitos := adicionar(feitos, u)",
          "saindo := filtrar(arestas, item[0] = u)"
        ],
        "examples": [
          {
            "name": "fecha o 2",
            "given": {
              "dist": [
                [
                  1,
                  0
                ],
                [
                  2,
                  5
                ],
                [
                  3,
                  9
                ]
              ],
              "feitos": [
                1
              ],
              "inf": 99,
              "arestas": [
                [
                  1,
                  2,
                  5
                ],
                [
                  2,
                  3,
                  1
                ]
              ]
            },
            "expect": {
              "candidatos": [
                [
                  2,
                  5
                ],
                [
                  3,
                  9
                ]
              ],
              "dmin": 5,
              "u": 2,
              "feitos": [
                1,
                2
              ],
              "saindo": [
                [
                  2,
                  3,
                  1
                ]
              ]
            }
          }
        ]
      },
      "x": 0,
      "y": 508,
      "w": 440,
      "h": 219
    },
    {
      "id": "interno",
      "label": "Para cada aresta que sai de u",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "foreach": "saindo",
        "as": "aresta",
        "text": "Uma volta por aresta que sai do nó recém-fechado. aresta[1] é o vizinho e aresta[2] o peso."
      },
      "x": 105,
      "y": 798,
      "w": 340,
      "h": 87
    },
    {
      "id": "calcula",
      "label": "Calcular o caminho passando por u",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Distância até o vizinho passando por u, e a que já se conhecia.",
        "then": [
          "v := aresta[1]",
          "novo := dmin + aresta[2]",
          "antigo := primeiro(mapear(filtrar(dist, item[0] = v), item[1]))"
        ],
        "examples": [
          {
            "name": "passa por u",
            "given": {
              "aresta": [
                2,
                3,
                1
              ],
              "dmin": 5,
              "dist": [
                [
                  3,
                  99
                ]
              ]
            },
            "expect": {
              "v": 3,
              "novo": 6,
              "antigo": 99
            }
          }
        ]
      },
      "x": 55,
      "y": 956,
      "w": 440,
      "h": 162
    },
    {
      "id": "melhora",
      "label": "Passar por u é mais barato?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "novo < antigo",
        "text": "Só vale se for estritamente menor que a distância conhecida.",
        "examples": [
          {
            "name": "melhora",
            "given": {
              "novo": 6,
              "antigo": 99
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "empata",
            "given": {
              "novo": 6,
              "antigo": 6
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 135,
      "y": 1182,
      "w": 330,
      "h": 101
    },
    {
      "id": "atualiza",
      "label": "Guardar a distância menor",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Troca o par antigo do vizinho pelo novo.",
        "then": [
          "dist := adicionar(filtrar(dist, item[0] != v), [v, novo])"
        ],
        "examples": [
          {
            "name": "troca",
            "given": {
              "dist": [
                [
                  1,
                  0
                ],
                [
                  3,
                  99
                ]
              ],
              "v": 3,
              "novo": 6
            },
            "expect": {
              "dist": [
                [
                  1,
                  0
                ],
                [
                  3,
                  6
                ]
              ]
            }
          }
        ]
      },
      "x": 255,
      "y": 1347,
      "w": 440,
      "h": 120
    },
    {
      "id": "le-resposta",
      "label": "Ler a distância do destino",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Procura o par do destino em dist.",
        "then": [
          "buscado := destino",
          "custo := primeiro(mapear(filtrar(dist, item[0] = buscado), item[1]))"
        ],
        "examples": [
          {
            "name": "destino 3",
            "given": {
              "dist": [
                [
                  1,
                  0
                ],
                [
                  3,
                  6
                ]
              ],
              "destino": 3
            },
            "expect": {
              "buscado": 3,
              "custo": 6
            }
          }
        ]
      },
      "x": 510,
      "y": 553.5,
      "w": 440,
      "h": 128
    },
    {
      "id": "alcancou",
      "label": "O destino foi alcançado?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "custo < inf",
        "text": "Se a distância do destino continua infinita, não há caminho.",
        "examples": [
          {
            "name": "sim",
            "given": {
