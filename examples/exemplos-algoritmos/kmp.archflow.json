                1
              ],
              "desfecho": "ok"
            }
          }
        ]
      },
      "x": 1800,
      "y": 1009,
      "w": 320,
      "h": 73
    },
    {
      "id": "caso-recuo-1",
      "label": "Recuo em cadeia na tabela",
      "kind": "logic",
      "parent": "cenarios",
      "logic": {
        "role": "scenario",
        "text": "Em aaab, a falha da letra b recua duas vezes (2 → 1 → 0): a tabela é 0, 1, 2, 0.",
        "examples": [
          {
            "name": "aaab",
            "given": {
              "texto": "aaaaab",
              "padrao": "aaab"
            },
            "expect": {
              "posicoes": [
                2
              ],
              "falha": [
                0,
                1,
                2,
                0
              ],
              "desfecho": "ok"
            }
          }
        ]
      },
      "x": 1800,
      "y": 1094,
      "w": 320,
      "h": 73
    },
    {
      "id": "caso-recuo-2",
      "label": "Recuo na busca sem perder letras",
      "kind": "logic",
      "parent": "cenarios",
      "logic": {
        "role": "scenario",
        "text": "Em mississippi, ao falhar no meio de issi, j recua pela tabela e a busca continua da mesma letra do texto: issi aparece nas posições 1 e 4.",
        "examples": [
          {
            "name": "mississippi",
            "given": {
              "texto": "mississippi",
              "padrao": "issi"
            },
