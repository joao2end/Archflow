            }
          }
        ]
      },
      "x": 1800,
      "y": 924,
      "w": 320,
      "h": 73
    },
    {
      "id": "caso-sobrepoe",
      "label": "Ocorrências que se sobrepõem",
      "kind": "logic",
      "parent": "cenarios",
      "logic": {
        "role": "scenario",
        "text": "Em aaaa, aa aparece nas posições 0, 1 e 2.",
        "examples": [
          {
            "name": "sobrepõe",
            "given": {
              "texto": "aaaa",
              "padrao": "aa"
            },
            "expect": {
