    },
    {
      "id": "inicio",
      "label": "Procurar o padrão no texto",
      "kind": "logic",
      "logic": {
        "role": "start",
        "text": "Entram texto e padrao."
      },
      "x": 660,
      "y": 0,
      "w": 280,
      "h": 60
    },
    {
      "id": "padrao-ok",
      "label": "O padrão tem pelo menos uma letra?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "tamanho(padrao) >= 1",
        "text": "Com padrão vazio não há o que procurar.",
        "examples": [
          {
            "name": "tem",
            "given": {
              "padrao": "ab"
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "vazio",
            "given": {
              "padrao": ""
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 635,
      "y": 124,
      "w": 330,
      "h": 102
    },
    {
      "id": "separa",
      "label": "Separar as letras",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Transforma os textos em listas de letras e guarda os tamanhos.",
        "then": [
          "lt := partir(texto, \"\")",
          "lp := partir(padrao, \"\")",
          "n := tamanho(lt)",
          "m := tamanho(lp)"
        ],
        "examples": [
          {
            "name": "duas palavras",
            "given": {
              "texto": "ab",
              "padrao": "a"
            },
            "expect": {
              "lt": [
                "a",
                "b"
              ],
              "lp": [
                "a"
              ],
              "n": 2,
              "m": 1
            }
          }
        ]
      },
      "x": 580,
      "y": 290,
      "w": 440,
      "h": 156
    },
    {
      "id": "prepara",
      "label": "Começar as duas fases",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "A tabela começa com 0 (o primeiro caractere nunca tem prefixo próprio); a fase 1 segue da posição 1 e a fase 2 do começo do texto.",
        "then": [
          "falha := [0]",
          "k := 0",
          "i := 1",
          "posicoes := []",
          "j := 0",
          "t := 0"
        ],
        "examples": [
          {
            "name": "começo",
            "given": {},
            "expect": {
              "falha": [
                0
              ],
              "k": 0,
              "i": 1,
              "posicoes": [],
              "j": 0,
              "t": 0
            }
          }
        ]
      },
      "x": 635,
      "y": 510,
      "w": 330,
      "h": 254
    },
    {
      "id": "l-falha",
      "label": "A tabela de falhas está completa?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "i >= m",
        "text": "Fase 1. Para quando i chegou a m. Cada volta calcula a falha de uma posição do padrão."
      },
      "x": 630,
      "y": 828,
      "w": 340,
      "h": 116
    },
    {
      "id": "l-recua-1",
      "label": "O recuo terminou?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "k = 0 ou lp[i] = lp[k]",
        "text": "Fase 1. Para quando k chegou a 0 ou quando a letra i do padrão casa com a letra k."
      },
      "x": 220,
      "y": 1008,
      "w": 340,
      "h": 115
    },
    {
      "id": "recua-1",
      "label": "Recuar o prefixo",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "A letra não casou: tenta um começo menor, o da tabela na posição anterior.",
        "then": [
          "k := falha[k - 1]"
        ],
        "examples": [
          {
            "name": "recua",
            "given": {
              "k": 2,
              "falha": [
                0,
                1,
                0,
                1
              ]
            },
            "expect": {
              "k": 1
            }
          }
        ]
      },
      "x": -280,
      "y": 1198,
      "w": 440,
      "h": 93
    },
    {
      "id": "casou-1",
      "label": "A letra i casa com a letra k?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "lp[i] = lp[k]",
        "text": "Se casa, o começo que casa fica uma letra maior.",
        "examples": [
          {
            "name": "casa",
            "given": {
              "lp": [
                "a",
                "b",
                "a"
              ],
              "i": 2,
              "k": 0
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "não casa",
            "given": {
              "lp": [
                "a",
                "b",
                "c"
              ],
              "i": 2,
              "k": 0
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 230,
      "y": 1194,
      "w": 330,
      "h": 101
    },
    {
      "id": "soma-k",
      "label": "Crescer o prefixo",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Mais uma letra casou.",
        "then": [
          "k := k + 1"
        ],
        "examples": [
          {
            "name": "cresce",
            "given": {
              "k": 1
            },
            "expect": {
              "k": 2
            }
          }
        ]
      },
      "x": -275,
      "y": 1370.5,
      "w": 330,
      "h": 107
    },
    {
      "id": "grava-falha",
      "label": "Guardar a falha da posição i",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "A falha de i é o k final; passa-se à próxima posição.",
        "then": [
          "falha := adicionar(falha, k)",
          "i := i + 1"
        ],
        "examples": [
          {
            "name": "grava",
            "given": {
              "falha": [
                0
              ],
              "k": 1,
              "i": 2
            },
            "expect": {
              "falha": [
                0,
                1
              ],
              "i": 3
            }
          }
        ]
      },
      "x": 125,
      "y": 1546,
      "w": 440,
      "h": 114
    },
    {
      "id": "l-texto",
      "label": "O texto acabou?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "t >= n",
        "text": "Fase 2. Para quando t chegou a n. Cada volta lê uma letra do texto."
      },
      "x": 630,
      "y": 1015,
      "w": 340,
      "h": 101
    },
    {
      "id": "l-recua-2",
      "label": "O recuo terminou?",
      "kind": "logic",
      "logic": {
        "role": "loop",
        "until": "j = 0 ou lt[t] = lp[j]",
        "text": "Fase 2. Para quando j chegou a 0 ou quando a letra do texto casa com a próxima letra do padrão."
      },
      "x": 630,
      "y": 1187,
      "w": 340,
      "h": 115
    },
    {
      "id": "recua-2",
      "label": "Recuar as letras casadas",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "A letra não casou: j volta para o que a tabela diz, sem reler o texto.",
        "then": [
          "j := falha[j - 1]"
        ],
        "examples": [
          {
            "name": "recua",
            "given": {
              "j": 2,
              "falha": [
                0,
                1,
                0,
                1
              ]
            },
            "expect": {
              "j": 1
            }
          }
        ]
      },
      "x": 125,
      "y": 1377.5,
      "w": 440,
      "h": 93
    },
    {
      "id": "casou-2",
      "label": "A letra do texto casa com a do padrão?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "lt[t] = lp[j]",
        "text": "Se casa, mais uma letra do padrão foi encontrada.",
        "examples": [
          {
            "name": "casa",
            "given": {
              "lt": [
                "a"
              ],
              "t": 0,
              "lp": [
                "a",
                "b"
              ],
              "j": 0
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "não casa",
            "given": {
              "lt": [
                "x"
              ],
              "t": 0,
              "lp": [
                "a",
                "b"
              ],
              "j": 0
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 635,
      "y": 1366,
      "w": 330,
      "h": 116
    },
    {
      "id": "soma-j",
      "label": "Mais uma letra casada",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Avança j.",
        "then": [
          "j := j + 1"
        ],
        "examples": [
          {
            "name": "avança",
            "given": {
              "j": 1
            },
            "expect": {
              "j": 2
            }
          }
        ]
      },
      "x": 635,
      "y": 1549.5,
      "w": 330,
      "h": 107
    },
    {
      "id": "achou",
      "label": "O padrão inteiro casou?",
      "kind": "logic",
      "logic": {
        "role": "decision",
        "when": "j = m",
        "text": "j chegou ao tamanho do padrão.",
        "examples": [
          {
            "name": "achou",
            "given": {
              "j": 2,
              "m": 2
            },
            "expect": {
              "caminho": "sim"
            }
          },
          {
            "name": "ainda não",
            "given": {
              "j": 1,
              "m": 2
            },
            "expect": {
              "caminho": "nao"
            }
          }
        ]
      },
      "x": 635,
      "y": 1724,
      "w": 330,
      "h": 87
    },
    {
      "id": "registra",
      "label": "Anotar a posição e recuar",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "A ocorrência começa em t − m + 1. Depois j recua pela tabela, para poder achar a próxima ocorrência mesmo que se sobreponha.",
        "then": [
          "posicoes := adicionar(posicoes, t - m + 1)",
          "j := falha[m - 1]"
        ],
        "examples": [
          {
            "name": "registra",
            "given": {
              "posicoes": [],
              "t": 3,
              "m": 2,
              "falha": [
                0,
                1
              ]
            },
            "expect": {
              "posicoes": [
                2
              ],
              "j": 1
            }
          }
        ]
      },
      "x": 580,
      "y": 1875,
      "w": 440,
      "h": 114
    },
    {
      "id": "proxima",
      "label": "Ir para a próxima letra do texto",
      "kind": "logic",
      "logic": {
        "role": "rule",
        "text": "Avança t.",
        "then": [
          "t := t + 1"
        ],
        "examples": [
          {
            "name": "avança",
            "given": {
              "t": 4
            },
            "expect": {
              "t": 5
            }
          }
        ]
      },
      "x": 635,
      "y": 2053,
      "w": 330,
      "h": 107
    },
    {
      "id": "pronto",
      "label": "Posições e tabela devolvidas",
      "kind": "logic",
      "logic": {
        "role": "end",
        "outcome": "ok",
        "text": "Devolve posicoes (onde o padrão aparece) e falha (a tabela do padrão)."
      },
      "x": 1040,
      "y": 1214.5,
      "w": 280,
      "h": 60
    },
    {
      "id": "padrao-vazio",
      "label": "Padrão vazio",
      "kind": "logic",
      "logic": {
        "role": "end",
        "outcome": "erro",
        "text": "Sem letras no padrão, não há o que procurar: termina sem devolver posicoes nem falha."
      },
      "x": 1090,
      "y": 338,
      "w": 280,
      "h": 60
    },
    {
      "id": "caso-classico",
      "label": "Padrão com recuos",
      "kind": "logic",
      "parent": "cenarios",
      "logic": {
        "role": "scenario",
        "text": "Em ababcabcabababd, o padrão ababd aparece só na posição 10; a tabela é 0, 0, 1, 2, 0.",
        "examples": [
