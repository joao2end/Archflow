        "goal": "desistir da compra antes do envio"
      },
      "x": 508,
      "y": 302,
      "w": 184,
      "h": 72
    },
    {
      "id": "acompanhar-uc",
      "label": "Acompanhar pedido",
      "kind": "domain",
      "parent": "pedidos",
      "ddd": {
        "role": "use-case",
        "actor": "Cliente",
        "goal": "saber em que etapa está o pedido",
        "realizedBy": [
          "consulta-de-pedidos"
        ]
      },
      "x": 748,
      "y": 302,
      "w": 184,
      "h": 72
    },
    {
      "id": "criar-pedido",
      "label": "Criar pedido",
      "kind": "domain",
      "parent": "pedidos",
      "ddd": {
        "role": "command",
        "step": 1,
        "intent": "registrar o pedido com os itens e o endereço",
        "properties": [
          {
            "name": "clienteId",
            "type": "uuid",
            "description": "quem está comprando"
          },
          {
            "name": "itens",
            "type": "Item do pedido[]",
            "description": "o que foi escolhido no carrinho, com a quantidade"
          },
          {
            "name": "endereco",
            "type": "Endereço de entrega",
            "description": "para onde enviar"
          }
        ]
      },
      "x": 28,
      "y": 426,
      "w": 184,
      "h": 72
    },
    {
      "id": "confirmar-pedido",
      "label": "Confirmar pedido",
      "kind": "domain",
      "parent": "pedidos",
      "ddd": {
        "role": "command",
        "step": 2,
        "intent": "pagamento e estoque deram certo"
      },
      "x": 268,
      "y": 426,
      "w": 184,
      "h": 72
    },
    {
      "id": "cancelar-pedido",
      "label": "Cancelar pedido",
      "kind": "domain",
      "parent": "pedidos",
      "ddd": {
        "role": "command",
        "step": 3,
        "intent": "encerrar o pedido (a pedido do cliente ou por falha)"
      },
      "x": 508,
      "y": 426,
      "w": 184,
      "h": 72
    },
    {
      "id": "pedido",
      "label": "Pedido",
      "kind": "domain",
      "parent": "pedidos",
      "ddd": {
        "role": "aggregate-root",
        "invariants": [
          "o total é a soma dos itens",
          "pedido confirmado não aceita novos itens",
          "pedido cancelado não volta a ser confirmado"
        ],
        "properties": [
          {
            "name": "id",
            "type": "uuid",
            "key": true,
            "description": "identifica o pedido em todo o sistema"
          },
          {
            "name": "clienteId",
            "type": "uuid",
            "description": "referência por id ao cliente (outro aggregate)"
          },
          {
            "name": "status",
            "type": "texto",
            "description": "criado, confirmado ou cancelado"
          },
          {
            "name": "total",
            "type": "Dinheiro",
            "description": "soma dos itens; recalculado a cada mudança"
          },
          {
            "name": "criadoEm",
            "type": "data e hora"
          },
          {
            "name": "motivoCancelamento",
            "type": "texto",
            "optional": true,
            "description": "só existe se o pedido foi cancelado"
          }
        ]
      },
      "x": 28,
      "y": 550,
      "w": 184,
      "h": 72
    },
    {
      "id": "item-do-pedido",
      "label": "Item do pedido",
      "kind": "domain",
      "parent": "pedidos",
      "ddd": {
        "role": "entity",
        "invariants": [
          "quantidade maior que zero"
        ],
        "properties": [
          {
            "name": "produtoId",
            "type": "uuid",
            "key": true,
            "description": "o produto comprado; um pedido não repete produto"
          },
          {
            "name": "quantidade",
            "type": "inteiro",
            "description": "quantas unidades"
          },
          {
            "name": "precoUnitario",
            "type": "Dinheiro",
            "description": "preço no momento da compra (não muda se o catálogo mudar)"
          }
        ]
      },
      "x": 28,
      "y": 1046,
      "w": 184,
      "h": 72
    },
    {
      "id": "endereco-de-entrega",
      "label": "Endereço de entrega",
      "kind": "domain",
      "parent": "pedidos",
      "ddd": {
        "role": "value-object",
        "properties": [
          {
            "name": "logradouro",
            "type": "texto"
          },
          {
            "name": "numero",
            "type": "texto"
          },
          {
            "name": "complemento",
            "type": "texto",
            "optional": true
          },
          {
            "name": "cidade",
            "type": "texto"
          },
          {
            "name": "cep",
            "type": "texto",
            "description": "8 dígitos, validado na criação"
          }
        ]
      },
      "x": 268,
      "y": 1046,
      "w": 184,
      "h": 72
    },
    {
      "id": "dinheiro",
      "label": "Dinheiro",
      "kind": "domain",
      "description": "Valor + moeda: nunca um número solto.",
      "parent": "pedidos",
      "ddd": {
        "role": "value-object",
        "properties": [
          {
            "name": "valor",
            "type": "inteiro",
            "description": "em centavos, para evitar erro de arredondamento",
            "example": "1999"
          },
          {
            "name": "moeda",
            "type": "texto",
            "description": "código ISO 4217",
            "example": "BRL"
          }
        ]
      },
      "x": 508,
      "y": 1046,
      "w": 184,
      "h": 72
    },
    {
      "id": "pedido-criado",
      "label": "Pedido criado",
      "kind": "domain",
      "parent": "pedidos",
      "ddd": {
        "role": "domain-event",
        "properties": [
          {
            "name": "pedidoId",
            "type": "uuid",
            "key": true
          },
          {
            "name": "itens",
            "type": "Item do pedido[]",
            "description": "para o estoque saber o que reservar"
          },
          {
            "name": "total",
            "type": "Dinheiro",
            "description": "para o pagamento saber quanto cobrar"
          }
        ]
      },
      "x": 28,
      "y": 674,
      "w": 184,
      "h": 72
    },
    {
      "id": "pedido-confirmado",
      "label": "Pedido confirmado",
      "kind": "domain",
      "parent": "pedidos",
