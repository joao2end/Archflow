      "x": 988,
      "y": 54,
      "w": 184,
      "h": 72
    },
    {
      "id": "fluxo-de-checkout",
      "label": "Fluxo de checkout",
      "kind": "domain",
      "description": "Saga: uma transação de negócio que atravessa três contextos, sem transação de banco entre eles. Se o pagamento falhar depois de reservar o estoque, o cancelamento dispara a compensação (liberar o estoque).",
      "parent": "pedidos",
      "ddd": {
        "role": "process-manager",
        "intent": "coordena pagamento e estoque: confirma quando os dois dão certo, cancela se algum falhar",
        "reactsTo": [
          "pedido-criado",
          "pagamento-aprovado",
          "cobranca-desistida",
          "estoque-reservado",
          "estoque-insuficiente"
        ],
        "issues": [
          "confirmar-pedido",
          "cancelar-pedido"
        ],
        "compensates": [
          "cancelar-pedido"
        ]
      },
      "x": 268,
      "y": 798,
      "w": 184,
      "h": 72
    },
    {
      "id": "pedidos-do-cliente",
      "label": "Pedidos do cliente",
      "kind": "domain",
      "parent": "pedidos",
      "ddd": {
        "role": "read-model",
        "projectsFrom": [
