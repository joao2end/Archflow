    {
      "id": "pedido",
      "label": "Pedido",
      "kind": "domain",
      "description": "O aggregate protege as regras do pedido inteiro: itens, total e estado mudam juntos, numa só transação.",
      "parent": "pedidos",
      "ddd": {
        "role": "aggregate-root",
        "invariants": [
          "o total é a soma dos itens",
          "pedido confirmado não aceita novos itens",
          "pedido cancelado não volta a ser confirmado",
          "todo item é do mesmo restaurante"
        ],
        "properties": [
          {
            "name": "id",
            "type": "uuid",
            "description": "identifica o pedido",
            "key": true
          },
          {
            "name": "clienteId",
            "type": "uuid",
            "description": "referência por id ao cliente"
          },
          {
            "name": "status",
            "type": "texto",
            "description": "criado, confirmado, concluído ou cancelado"
          },
          {
            "name": "total",
            "type": "Dinheiro",
            "description": "soma dos itens"
          },
          {
            "name": "promessaDeEntrega",
            "type": "data e hora",
            "description": "o prazo combinado com o cliente"
          },
          {
            "name": "motivoCancelamento",
            "type": "texto",
            "description": "só existe se foi cancelado",
            "optional": true
          }
        ]
      },
      "x": 28,
      "y": 550,
      "w": 184,
      "h": 72
    },
