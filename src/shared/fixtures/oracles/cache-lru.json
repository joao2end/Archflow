{
  "enunciado": "Cache de capacidade cap (≥ 1) que guarda pares chave→valor. Recebe uma lista de operações: [\"put\", chave, valor] guarda (ou troca o valor de) uma chave; [\"get\", chave] devolve o valor ou -1 se a chave não está. Tanto get (que acha) quanto put contam como uso. Ao guardar uma chave NOVA com o cache cheio, sai primeiro a chave usada há mais tempo (a menos recente). Devolver a lista com o resultado de cada get, na ordem.",
  "cases": [
    {
      "name": "sem operações",
      "given": {
        "cap": 2,
        "ops": []
      },
      "expect": {
        "saidas": []
      }
    },
    {
      "name": "get de chave ausente",
      "given": {
        "cap": 2,
        "ops": [
          [
            "get",
            1
          ]
        ]
      },
      "expect": {
        "saidas": [
          -1
        ]
      }
    },
    {
      "name": "exemplo clássico",
      "given": {
        "cap": 2,
        "ops": [
          [
            "put",
            1,
            1
          ],
          [
            "put",
            2,
            2
          ],
          [
            "get",
            1
          ],
          [
            "put",
            3,
            3
          ],
          [
            "get",
            2
          ],
          [
            "put",
            4,
            4
          ],
          [
            "get",
            1
          ],
          [
            "get",
            3
          ],
          [
            "get",
            4
          ]
        ]
      },
      "expect": {
        "saidas": [
          1,
          -1,
          -1,
          3,
          4
        ]
      }
    },
    {
      "name": "put de chave existente renova o uso",
      "given": {
        "cap": 2,
        "ops": [
          [
            "put",
            1,
            1
          ],
          [
            "put",
            2,
            2
          ],
          [
            "put",
            1,
            10
          ],
          [
            "put",
            3,
            3
          ],
          [
            "get",
            2
          ],
          [
            "get",
            1
          ]
        ]
      },
      "expect": {
        "saidas": [
          -1,
          10
        ]
      }
    },
    {
      "name": "capacidade 1",
      "given": {
        "cap": 1,
        "ops": [
          [
            "put",
            1,
            1
          ],
          [
            "put",
            2,
            2
          ],
          [
            "get",
            1
          ],
          [
            "get",
            2
          ]
        ]
      },
      "expect": {
        "saidas": [
          -1,
          2
        ]
      }
    },
    {
      "name": "get ausente não muda a ordem",
      "given": {
        "cap": 2,
        "ops": [
          [
            "put",
            1,
            1
          ],
          [
            "put",
            2,
            2
          ],
          [
            "get",
            3
          ],
          [
            "put",
            3,
            3
          ],
          [
            "get",
            1
          ],
          [
            "get",
            2
          ]
        ]
      },
      "expect": {
        "saidas": [
          -1,
          -1,
          2
        ]
      }
    },
    {
      "name": "get renova o uso",
      "given": {
        "cap": 2,
        "ops": [
          [
            "put",
            1,
            1
          ],
          [
            "put",
            2,
            2
          ],
          [
            "get",
            1
          ],
          [
            "put",
            3,
            3
          ],
          [
            "get",
            2
          ],
          [
            "get",
            1
          ]
        ]
      },
      "expect": {
        "saidas": [
          1,
          -1,
          1
        ]
      }
    },
    {
      "name": "valor zero é valor",
      "given": {
        "cap": 1,
        "ops": [
          [
            "put",
            1,
            0
          ],
          [
            "get",
            1
          ]
        ]
      },
      "expect": {
        "saidas": [
          0
        ]
      }
    },
    {
      "name": "operação desconhecida",
      "given": {
        "cap": 2,
        "ops": [
          [
