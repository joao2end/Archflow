      "given": {
        "simbolos": [
          3,
          "+",
          4,
          "*",
          2
        ]
      },
      "expect": {
        "saida": [
          3,
          4,
          2,
          "*",
          "+"
        ],
        "desfecho": "ok"
      }
    },
    {
      "name": "multiplicação no começo",
      "given": {
        "simbolos": [
          3,
          "*",
          4,
          "+",
          2
        ]
