{
  "enunciado": "Dada uma lista de números a, devolver o tamanho do maior trecho contíguo (posições seguidas) em que nenhum número se repete. Lista vazia dá 0. Deve percorrer a lista uma só vez (O(n) voltas).",
  "cases": [
    {
      "name": "lista vazia",
      "given": {
        "a": []
      },
      "expect": {
        "melhor": 0
      }
    },
    {
      "name": "um elemento",
      "given": {
        "a": [
          5
        ]
      },
      "expect": {
        "melhor": 1
      }
    },
    {
      "name": "tudo igual",
      "given": {
        "a": [
          7,
          7,
          7
        ]
      },
      "expect": {
        "melhor": 1
      }
    },
    {
      "name": "sem repetição",
      "given": {
        "a": [
          1,
          2,
          3,
          4
        ]
      },
      "expect": {
        "melhor": 4
      }
    },
    {
      "name": "ciclo",
      "given": {
        "a": [
          1,
          2,
          3,
          1,
          2,
          3
        ]
      },
      "expect": {
        "melhor": 3
      }
    },
    {
      "name": "repetição no começo",
      "given": {
        "a": [
          3,
          3,
          4,
          5
        ]
      },
      "expect": {
        "melhor": 3
      }
    },
    {
      "name": "janela maior no fim",
      "given": {
        "a": [
          4,
          1,
          2,
          3,
          1,
          5,
          6
        ]
      },
      "expect": {
        "melhor": 5
      }
    },
    {
      "name": "duplicata antiga fora da janela",
      "given": {
        "a": [
          1,
          2,
          3,
          2,
          1
        ]
      },
      "expect": {
        "melhor": 3
      }
    },
    {
      "name": "janela no meio",
      "given": {
        "a": [
          1,
          2,
          1,
          3,
          4,
          3
        ]
      },
      "expect": {
        "melhor": 4
      }
    }
  ]
}